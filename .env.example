OPENAI_API_KEY=replace-me
PC_API_KEY=replace-me

# Keep "auto" for current PrivateCircle responses. Set to "inr" only for a
# legacy account whose statement responses contain raw rupee values.
PC_FINANCIAL_INPUT_UNIT=auto

# Recommended for any internet-accessible deployment.
APP_PASSWORD=replace-me

# Optional model overrides.
OPENAI_RESEARCH_MODEL=gpt-5.6-terra
OPENAI_REWRITE_MODEL=gpt-5.6-luna

# Optional browser path override. Mergermarket credentials must NOT be placed
# here; the user enters them into the app for each browser session.
# MERGERMARKET_BROWSER_EXECUTABLE=/usr/bin/chromium
